# Copy to .env.local (never commit it). Every value is optional:
# with none set, Dayflow runs fully on-device (no sign-in, sync, calendar, email or push).
# How to get each one for free: docs/SETUP.md

# Supabase -> Project Settings -> API. The anon/publishable key is public by design;
# row level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public VAPID key for reminders while the app is closed (npm run vapid).
VITE_VAPID_PUBLIC_KEY=
