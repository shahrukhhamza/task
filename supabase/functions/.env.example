# Edge Function secrets. Copy to supabase/functions/.env (git-ignored), fill in, then:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Google Cloud -> Credentials -> your OAuth client (google-calendar function)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend -> API Keys (daily-summary function)
RESEND_API_KEY=
# Without a verified domain Resend only delivers from this sender to your own account email
EMAIL_FROM=Dayflow <onboarding@resend.dev>

# Where the app is hosted, for links inside emails
APP_URL=http://localhost:5173

# Random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
UNSUBSCRIBE_SECRET=

# npx web-push generate-vapid-keys (send-reminders function)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: Gemini for signed-in users without their own key (ai function).
# Free key: https://aistudio.google.com/apikey. GEMINI_MODEL is optional; by default the
# best available Flash model is picked automatically.
GEMINI_API_KEY=
GEMINI_MODEL=
